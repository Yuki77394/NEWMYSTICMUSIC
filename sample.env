# ---------------------------------------------------------------------------
# Central Music Archive — SHARED CACHE with CHANNELSRMUSIC (optional).
#
# When enabled, every successfully downloaded YouTube AUDIO track (MP3) is
# silently archived in the background to:
#   1. A Telegram storage channel (STORAGE_CHANNEL_ID)
#   2. The SHARED MongoDB music cache (same MONGO_DB_URI + Anon.music_cache
#      collection used by CHANNELSRMUSIC) so CHANNELSRMUSIC can find and
#      reuse the Telegram file_id without any changes to its own lookup.
#
# Video / MP4 is NEVER archived. Archival never blocks playback.
#
# Required for archival:
#   CENTRAL_MUSIC_ARCHIVE_ENABLED=true
#   MONGO_DB_URI (same as CHANNELSRMUSIC — shared cache)
#   STORAGE_CHANNEL_ID
#
# Optional legacy override (leave UNSET to use the shared MONGO_DB_URI):
#   CENTRAL_MONGO_DB_URI — if set, archive uses a SEPARATE Mongo connection
#
# Optional schema overrides (defaults match CHANNELSRMUSIC exactly):
#   CENTRAL_MUSIC_ARCHIVE_DB=Anon
#   CENTRAL_MUSIC_ARCHIVE_COLL=music_cache
#   CENTRAL_ARCHIVE_SOURCE_BOT=MystMusic
# ---------------------------------------------------------------------------
CENTRAL_MUSIC_ARCHIVE_ENABLED=false
STORAGE_CHANNEL_ID=
# Optional legacy override (leave empty to use shared MONGO_DB_URI):
CENTRAL_MONGO_DB_URI=
