# YouTube backend (new API used by platforms/Youtube.py + utils/autoplay.py + utils/thumbnails.py + core/prewarm.py).
# Defaults are baked into the code if these are not set.
API_URL=http://yt.riteshyt.in
API_KEY=riteshfree576fd88ed84a3f46c84fd556

# ---------------------------------------------------------------------------
# Central Music Archive (OPTIONAL — leave all unset to disable).
# When enabled, every successfully downloaded YouTube AUDIO track (MP3) is
# silently archived in the background to a Telegram storage channel AND a
# separate central MongoDB (completely independent of MONGO_DB_URI above).
# Video / MP4 is NEVER archived. Archival never blocks playback.
# All three values must be set for archival to be active.
# ---------------------------------------------------------------------------
CENTRAL_MUSIC_ARCHIVE_ENABLED=false
CENTRAL_MONGO_DB_URI=
STORAGE_CHANNEL_ID=
# Optional overrides (defaults shown):
# CENTRAL_MUSIC_ARCHIVE_DB=music_archive
# CENTRAL_MUSIC_ARCHIVE_COLL=tracks
# CENTRAL_ARCHIVE_SOURCE_BOT=MystMusic
